# --- Database ---------------------------------------------------------------
# SQLite by default (zero infra for demos). For Postgres:
#   DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/finance
DATABASE_URL=sqlite:///./data/finance_controller.db

# --- Auth -------------------------------------------------------------------
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_MINUTES=480

# --- Reconciliation rules ---------------------------------------------------
# Transactions above this amount always require human review (SRS 51).
HIGH_VALUE_THRESHOLD=50000
# Settlements arriving more than this many days after the payment are flagged.
SETTLEMENT_DELAY_WINDOW_DAYS=3

# --- AI (optional — leave empty to run the deterministic analyzer only) -----
# Any OpenAI-compatible chat-completions endpoint works (OpenAI, Groq, Ollama...).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# --- Dev --------------------------------------------------------------------
CORS_ORIGINS=*